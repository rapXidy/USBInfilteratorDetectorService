{
  "AppSettings": {
    "CorpCode": "ACME-UK-001",
    "ApiBaseUrl": "https://localhost:44357",
    "ApiKey": "",
    "OfflineQueuePath": "C:\\ProgramData\\UsbDetector\\queue",
    "PollingIntervalSeconds": 5,
    "MaxBatchSize": 50,
    "EnableVerboseLogging": false,
    "CronInterval": "*/1 * * * *",
    "UsbCooldownSeconds": 60,
    "LogPath": "C:\\ProgramData\\UsbDetector\\logs",
    "SeqServerUrl": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\ProgramData\\UsbDetector\\logs\\usb-detector-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
